# Copy to .env and fill in. NEVER commit .env.

# Paper trading keys (from https://app.alpaca.markets, paper account)
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Live keys — leave EMPTY until the M8 review gate is passed.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# Live mode also requires this exact confirmation string:
# BOTTSKI_LIVE_CONFIRM=I-UNDERSTAND-THIS-TRADES-REAL-MONEY

# Reddit script app (from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
