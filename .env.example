# Copy to .env and fill in. NEVER commit .env.
# (Deploys rsync with --exclude .env; the droplet copy may hold more keys
#  than the local one — never overwrite it blindly.)

# Alpaca paper trading keys (app.alpaca.markets -> Paper account -> API Keys)
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Live keys — leave EMPTY until the M8 review gate is passed.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
# Live mode also requires this exact confirmation string:
# BOTTSKI_LIVE_CONFIRM=I-UNDERSTAND-THIS-TRADES-REAL-MONEY

# Reddit script app (reddit.com/prefs/apps) — leave empty until Reddit's
# Data Access Request is approved; collection skips cleanly while empty.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=bottski/0.1 (research bot)

# healthchecks.io project ping key (Settings -> Ping key). Optional; when set,
# every job pings https://hc-ping.com/<key>/bottski-<job> on success.
HEALTHCHECKS_PING_BASE=

# Cloudflare R2 (S3 API) for nightly DB backups. Bucket-scoped token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# Massive (ex-Polygon) — optional; used by tools/massive_export only
MASSIVE_API_KEY=
