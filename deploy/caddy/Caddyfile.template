# T1 dashboard: serves data/www (report page only — NEVER the data/ root, the
# db lives there) over HTTPS with basic auth. Deployed to /etc/caddy/Caddyfile
# with the password hash substituted (caddy hash-password).
# Site 1: your dashboard domain (real Let's Encrypt cert). Site 2: IP/localhost fallback.
<dashboard-domain> {
    root * /home/bottski/bottski/data/www
    file_server
    basic_auth {
        jochen {$DASH_HASH}
    }
}
https://<droplet-ip>, https://localhost {
    tls internal
    root * /home/bottski/bottski/data/www
    file_server
    basic_auth {
        jochen {$DASH_HASH}
    }
}
http:// {
    redir https://<dashboard-domain>{uri} permanent
}
